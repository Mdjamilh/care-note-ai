# Optional. Leave empty to use the embedded PGlite database (auto-migrated).
# For persistent storage, point this at Postgres (e.g. a free Neon database).
DATABASE_URL=

# Optional. Enables AI drafting from any transcript. Without it, the app runs in
# demo mode and drafts notes only for the built-in sample visits.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=

# Optional. Drafts allowed per IP per minute (default 6).
DRAFT_RATE_LIMIT=
